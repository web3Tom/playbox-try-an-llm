# Polestar Playbox — environment template.
# Copy to .env (scripts/init.sh does this for you). NEVER commit .env.
# The real values are provided by the Playbox image / vault — these are placeholders.

# Azure OpenAI via the Playbox APIM gateway
AZURE_OPENAI_ENDPOINT="https://<your-playbox-apim-endpoint>/playbox-ai-deployment/openai"
AZURE_OPENAI_API_KEY="your-key-here"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Internal GitLab (for the gitlab-agent demo)
GITLAB_API_URL="https://<your-internal-gitlab>/api/v4"
GITLAB_PROJECT_ID="00000"
GITLAB_PAT="your-gitlab-pat-here"
