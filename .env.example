# Polestar Playbox — environment template.
# Copy to .env (scripts/init.sh does this for you). NEVER commit .env.
# Real values come from the Playbox image / vault — these are placeholders.

# Azure OpenAI via APIM (Playbox) — Responses API endpoint
# Resource base WITHOUT the /openai suffix — the openai SDK appends /openai/responses itself.
# (Kilo's openai-compatible client adds /openai in .kilo/kilo.jsonc baseUrl.)
AZURE_OPENAI_ENDPOINT=https://<your-playbox-apim-endpoint>/playbox-ai-deployment

# Token / subscription key — APIM does not enforce a key; leave as None
AZURE_OPENAI_API_KEY=None

# API version
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Default Azure deployment (model) — must match a model defined in .kilo/kilo.jsonc
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Enable streaming if available
AZURE_OPENAI_ENABLE_STREAMING=true

# Corporate CA bundle (required in locked-down environments)
SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-bundle.crt

# Internal GitLab (gitlab-agent demo + codebase-analyzer clone)
GITLAB_API_URL=https://<your-internal-gitlab>/api/v4
GITLAB_PROJECT_ID=00000
GITLAB_PAT=your-gitlab-pat-here
